{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alio-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2a1086a4-9340-4a96-a71d-96ba14c31026","database_name": "alioproxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ce40d560d9ff49ccae27f44c932f001f" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
